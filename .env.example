# Copy to .env.local and fill in. Never commit .env.local.
# Without a key the app works fully; AI features show as unavailable.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional. Max AI requests per session per hour (default 30).
AI_RATE_LIMIT=30
